# Normalize text to CRLF in the working tree (matches the editor default),
# stored as LF in the repository. Stops the LF/CRLF churn warnings.
* text=auto eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.arrow binary

# Git runs the hooks with sh, which reads a CR as part of the command.
.husky/** text eol=lf
